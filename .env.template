# Core API keys
#
# OpenAI API key used by Agency Swarm / SkillCreatorAgency.
# Get one from your OpenAI account dashboard.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Claude Skills MCP backend / GitHub access
#
# If you add remote GitHub-based skills and hit unauthenticated rate limits,
# you can set a GitHub token here and reference it in claude-skills-mcp-config.json
# (for example via an environment variable, depending on backend configuration).
# GITHUB_API_TOKEN=your_github_token_here